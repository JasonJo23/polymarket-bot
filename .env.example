# =============================================================================
# .env example - Polymarket CopyTrader Scout
# Copy these values into the real .env on the server and fill secrets locally.
# Do not commit real API keys, wallet private keys, or Telegram tokens.
# =============================================================================

# --- General ---
POLL_INTERVAL_SECONDS=600
DRY_RUN=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CYCLE_SUMMARY_ENABLED=true
TELEGRAM_CYCLE_SUMMARY_SECONDS=3600
TELEGRAM_CYCLE_SUMMARY_CYCLES=0

# --- Closing Soon strategy ---
CLOSING_DAYS=3
CLOSING_HOURS_MIN=1
MIN_VOLUME_24H=30000
TOP_MARKETS=10
MARKET_SCAN_LIMIT=500
MARKET_PAGE_SIZE=100
ALLOW_TOP_MARKETS_FALLBACK=false

# --- Wallet discovery ---
VOLUME_SPIKE_HOURS=2
MIN_SPIKE_WALLETS=10
MAX_SPIKE_WALLETS=0
TOP_HOLDERS=10
HISTORY_LIMIT_PER_WALLET=300
SCORING_HISTORY_LIMIT=200
SCORING_WORKERS=20
MARKET_ACTIVITY_LIMIT=100

# --- Wallet quality ---
MIN_WIN_RATE=0.60
MIN_TRADES_48H=3
MIN_AVG_SIZE_USDC=200
MAX_AVG_SIZE_USDC=5000
MIN_WALLET_WEIGHT=0.4
UNKNOWN_WALLET_WEIGHT=0.7
UNKNOWN_CATEGORY_WEIGHT=0.7
MIN_CATEGORY_RESOLVED=3
MIN_TRADES_14D_FOR_ACTIVE=5
INACTIVE_WALLET_MAX_WEIGHT=0.8
INACTIVE_SIGNAL_MAX_WEIGHT=0.8
MIN_ACTIVE_SUPPORT=1
MIN_WEIGHTED_SUPPORT_RATIO=0.75
MIN_HIGH_WEIGHT_SUPPORT=0

# --- Known wallet universe ---
KNOWN_WALLETS_ENABLED=true
KNOWN_WALLET_SCAN_LIMIT=40
KNOWN_WALLET_SCAN_MIN_WEIGHT=0.7
KNOWN_WALLET_SCAN_MIN_TRADES_14D=5
KNOWN_WALLET_MAX_STORED=1000

# --- Smart Follow ---
SMART_FOLLOW_THRESHOLD=3
MIN_SIGNAL_SIZE_USDC=50000
MIN_POSITIVE_ROI_SUPPORT=1
UNKNOWN_SUPPORT_OVERRIDE=8
ESPORTS_MATCH_MIN_SUPPORT=5
ESPORTS_MAP_MIN_SUPPORT=6
MAX_SIGNAL_PRICE_MOVE=0.10

# --- Fresh spike signal path ---
FRESH_SPIKE_MIN_SUPPORT=7
FRESH_SPIKE_MIN_SIZE_USDC=60000
FRESH_SPIKE_MIN_SOURCE_SUPPORT=4
FRESH_SPIKE_MIN_WEIGHTED_RATIO=0.60
FRESH_SPIKE_MAX_PRICE_MOVE=0.08
FRESH_SPIKE_MIN_ACTIVE_SUPPORT=1
FRESH_SPIKE_MIN_SCOUT_SCOPE_SUPPORT=0
FRESH_SPIKE_ORDER_MULTIPLIER=0.5

# --- Late high-quality override ---
LATE_QUALITY_MAX_PRICE_MOVE=0.18
LATE_QUALITY_MIN_SUPPORT=9
LATE_QUALITY_MIN_WEIGHTED_SUPPORT=9
LATE_QUALITY_MIN_HIGH_WEIGHT_SUPPORT=4

# --- Intelligence / edge ---
MIN_CONFIDENCE=20
MIN_LIQUIDITY=0.05
INTELLIGENCE_FAIL_OPEN=false
MIN_MAX_PROFIT_USDC=5
EDGE_REJECT_COOLDOWN_CYCLES=10
EDGE_COOLDOWN_PRICE_MOVE=0.03
EDGE_COOLDOWN_WEIGHT_MOVE=2.0
EDGE_DETECTOR_ENABLED=true
EDGE_DETECTOR_FAIL_OPEN=false
MIN_EDGE_THRESHOLD=0.08
MIN_DATA_QUALITY=0.3
MIN_TOKEN_PRICE=0.25
MAX_TOKEN_PRICE=0.85
PROBABILITY_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# --- Risk management ---
CURRENT_BANKROLL_USDC=190
MIN_BANKROLL_USDC=80
MAX_DAILY_LOSS_USDC=200
MAX_DAILY_SPEND_USDC=200
MAX_DAILY_REALIZED_LOSS_USDC=200
MAX_ORDERS_PER_CYCLE=3
MAX_ORDER_SIZE_USDC=40
MIN_ORDER_SIZE_USDC=10
POSITION_CHECK_SECONDS=300
POSITION_DUST_TOKEN_THRESHOLD=0.01
POSITION_DUST_USDC_THRESHOLD=0.25

# --- Market-aware price and order controls ---
ORDER_SIZE_LOW_CONFIDENCE=10
ORDER_SIZE_MEDIUM_CONFIDENCE=20
ORDER_SIZE_HIGH_CONFIDENCE=40
MACRO_MIN_TOKEN_PRICE=0.20
MACRO_MAX_TOKEN_PRICE=0.85
SPORTS_MIN_TOKEN_PRICE=0.25
SPORTS_MAX_TOKEN_PRICE=0.85
ESPORTS_MATCH_MIN_TOKEN_PRICE=0.30
ESPORTS_MATCH_MAX_TOKEN_PRICE=0.78
ESPORTS_MAP_MIN_TOKEN_PRICE=0.35
ESPORTS_MAP_MAX_TOKEN_PRICE=0.70
GENERAL_MIN_TOKEN_PRICE=0.25
GENERAL_MAX_TOKEN_PRICE=0.80
CANDIDATE_PRICE_BUFFER=0.02
MACRO_ORDER_MULTIPLIER=1.0
SPORTS_ORDER_MULTIPLIER=1.0
ESPORTS_MATCH_ORDER_MULTIPLIER=0.75
ESPORTS_MAP_ORDER_MULTIPLIER=0.5
GENERAL_ORDER_MULTIPLIER=0.8
MACRO_MAX_ORDER_SIZE_USDC=40
SPORTS_MAX_ORDER_SIZE_USDC=40
ESPORTS_MATCH_MAX_ORDER_SIZE_USDC=25
ESPORTS_MAP_MAX_ORDER_SIZE_USDC=15
GENERAL_MAX_ORDER_SIZE_USDC=20

# --- Exit / bad-fill controls ---
SPORTS_PROFIT_LOCK_PRICE=0.92
SPORTS_STOP_PRICE=0.10
ESPORTS_PROFIT_LOCK_PRICE=0.90
ESPORTS_MAP_STOP_LOSS=-0.30
ESPORTS_MAP_TAKE_PROFIT=0.30
SLIPPAGE_PCT=0.02
LIMIT_SELL_PRICE_MULTIPLIER=0.98
STOP_LOSS_SELL_PRICE_MULTIPLIER=0.90
BAD_FILL_SLIPPAGE_PCT=0.05
BAD_FILL_SLIPPAGE_ABS=0.03
BAD_FILL_FORCE_EXIT=true
PENDING_ORDER_MAX_ATTEMPTS=24

# --- Fresh context providers ---
FRESH_CONTEXT_ENABLED=true
FRESH_CONTEXT_DEBUG=false
PANDASCORE_API_KEY=
PANDASCORE_MATCH_LIMIT=50
MYSPORTSFEEDS_API_KEY=
MYSPORTSFEEDS_PASSWORD=MYSPORTSFEEDS
ESPN_SCOREBOARD_LOOKBACK_DAYS=1
ESPN_SCOREBOARD_LOOKAHEAD_DAYS=7
ESPN_SCOREBOARD_LIMIT=100
GAMMA_FALLBACK_MIN_MATCH=0.55

# --- API settings ---
REQUEST_DELAY_SECONDS=0.3
FETCH_WORKERS=16
MAX_RETRIES=3
WALLET_SCORE_CACHE_TTL_MINUTES=180
WALLET_SCORE_MAX_MARKETS=50
SIGNAL_STATE_RETENTION_DAYS=7
SIGNAL_SNAPSHOT_ENABLED=true

# --- CLOB API (required when DRY_RUN=false) ---
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_PASSPHRASE=
PRIVATE_KEY=
PROXY_WALLET_ADDRESS=
